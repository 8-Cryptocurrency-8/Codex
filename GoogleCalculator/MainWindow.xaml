<Window x:Class="GoogleCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoogleCalculator"
        mc:Ignorable="d"
        Title="Google Calculator" Height="500" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#222" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Display" Grid.Row="0" Text="0" FontSize="48" Foreground="White" HorizontalAlignment="Right" Margin="10"/>

            <Button Grid.Row="1" Content="AC" Background="#666" Click="ClearButton_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="+/-" Background="#666" Click="OperatorButton_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="%" Background="#666" Click="OperatorButton_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Content="/" Background="Orange" Click="OperatorButton_Click"/>

            <Button Grid.Row="2" Grid.Column="0" Content="7" Click="NumberButton_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="8" Click="NumberButton_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="9" Click="NumberButton_Click"/>
            <Button Grid.Row="2" Grid.Column="3" Content="*" Background="Orange" Click="OperatorButton_Click"/>

            <Button Grid.Row="3" Grid.Column="0" Content="4" Click="NumberButton_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="5" Click="NumberButton_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="6" Click="NumberButton_Click"/>
            <Button Grid.Row="3" Grid.Column="3" Content="-" Background="Orange" Click="OperatorButton_Click"/>

            <Button Grid.Row="4" Grid.Column="0" Content="1" Click="NumberButton_Click"/>
            <Button Grid.Row="4" Grid.Column="1" Content="2" Click="NumberButton_Click"/>
            <Button Grid.Row="4" Grid.Column="2" Content="3" Click="NumberButton_Click"/>
            <Button Grid.Row="4" Grid.Column="3" Content="+" Background="Orange" Click="OperatorButton_Click"/>

            <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Click="NumberButton_Click"/>
            <Button Grid.Row="5" Grid.Column="2" Content="." Click="NumberButton_Click"/>
            <Button Grid.Row="5" Grid.Column="3" Content="=" Background="Orange" Click="EqualsButton_Click"/>
        </Grid>
    </Border>
</Window>
